@model T2LifestyleChecker.Web.ViewModels.QuestionnaireViewModel

@{
    ViewData["Title"] = "Lifestyle Questionnaire";
}

<h1>Lifestyle Questionnaire</h1>

<p>
    Please answer all three questions.
</p>

<form asp-controller="Questionnaire"
      asp-action="Index"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <!-- Q1 -->
    <div class="mb-4">

        <p>
            <strong>
                Q1. Do you drink on more than 2 days a week?
            </strong>
        </p>

        <div>
            <input asp-for="DrinksMoreThanTwoDays"
                   type="radio"
                   value="true"
                   id="q1Yes" />

            <label for="q1Yes">
                Yes
            </label>
        </div>

        <div>
            <input asp-for="DrinksMoreThanTwoDays"
                   type="radio"
                   value="false"
                   id="q1No" />

            <label for="q1No">
                No
            </label>
        </div>

        <span asp-validation-for="DrinksMoreThanTwoDays"
              class="text-danger">
        </span>

    </div>


    <!-- Q2 -->
    <div class="mb-4">

        <p>
            <strong>
                Q2. Do you smoke?
            </strong>
        </p>

        <div>
            <input asp-for="Smokes"
                   type="radio"
                   value="true"
                   id="q2Yes" />

            <label for="q2Yes">
                Yes
            </label>
        </div>

        <div>
            <input asp-for="Smokes"
                   type="radio"
                   value="false"
                   id="q2No" />

            <label for="q2No">
                No
            </label>
        </div>

        <span asp-validation-for="Smokes"
              class="text-danger">
        </span>

    </div>


    <!-- Q3 -->
    <div class="mb-4">

        <p>
            <strong>
                Q3. Do you exercise more than 1 hour per week?
            </strong>
        </p>

        <div>
            <input asp-for="ExercisesMoreThanOneHour"
                   type="radio"
                   value="true"
                   id="q3Yes" />

            <label for="q3Yes">
                Yes
            </label>
        </div>

        <div>
            <input asp-for="ExercisesMoreThanOneHour"
                   type="radio"
                   value="false"
                   id="q3No" />

            <label for="q3No">
                No
            </label>
        </div>

        <span asp-validation-for="ExercisesMoreThanOneHour"
              class="text-danger">
        </span>

    </div>


    <button type="submit"
            class="btn btn-primary">
        Submit
    </button>

</form>